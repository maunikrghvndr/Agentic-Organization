# Baseline analyzer rules for C# (.NET SDK analyzers; no extra package needed).
# Offered only where the repository has no analyzer configuration in any location; never merged over one.
# Enforced at build time only with the properties in Directory.Build.props beside this file.

[*.cs]

# Explicit types: `var` only for built-in types where the type is obvious.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0008.severity = error

# Structured logging: constant message templates with named placeholders.
# the template is not built by interpolation or concatenation
dotnet_diagnostic.CA2254.severity = error
# placeholders and arguments match in number
dotnet_diagnostic.CA2017.severity = error
# placeholders are named, not numbered
dotnet_diagnostic.CA2253.severity = error
# placeholder names are PascalCase
dotnet_diagnostic.CA1727.severity = error

# Async and cancellation.
# forward the CancellationToken
dotnet_diagnostic.CA2016.severity = error
# ValueTask used correctly
dotnet_diagnostic.CA2012.severity = error
# no blocking call where an async one exists
dotnet_diagnostic.CA1849.severity = error

# Errors and resources.
# no catch-all without a reason
dotnet_diagnostic.CA1031.severity = error
# dispose what you create (reports some false positives, so it stays a warning: see WarningsNotAsErrors)
dotnet_diagnostic.CA2000.severity = warning

# Nullability.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error

# Security.
# SQL built from input
dotnet_diagnostic.CA2100.severity = error
# weak cryptography
dotnet_diagnostic.CA5350.severity = error
# broken cryptography
dotnet_diagnostic.CA5351.severity = error

# Needless complexity.
# excessive cyclomatic complexity (a warning: see WarningsNotAsErrors)
dotnet_diagnostic.CA1502.severity = warning
